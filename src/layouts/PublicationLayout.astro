---
import '../styles/global.css';
import SiteIcons from '../components/SiteIcons.astro';
interface Props {
  frontmatter: { title: string; published?: boolean; description?: string };
}
const { frontmatter } = Astro.props;
const base = import.meta.env.BASE_URL;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#032355" />
    {!frontmatter.published && <meta name="robots" content="noindex, follow" />}
    {frontmatter.description && <meta name="description" content={frontmatter.description} />}
    <link rel="canonical" href={canonical} />
    <SiteIcons />
    <title>{frontmatter.title} — Dixios</title>
  </head>
  <body>
    <a class="skip-link" href="#articulo">Saltar al contenido</a>
    <header class="article-header">
      <a class="wordmark" href={base} aria-label="Dixios, volver al inicio">dixios</a>
      <a class="article-back" href={`${base}#publicaciones`}>Volver a publicaciones</a>
    </header>
    <main id="articulo">
      <article>
        <h1>{frontmatter.title}</h1>
        <div class="article-body"><slot /></div>
      </article>
    </main>
  </body>
</html>

<style>
  body {
    min-height: 100vh;
    min-height: 100svh;
    color: #032355;
    background: #fdfdfb;
  }
  .article-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    max-width: 1120px;
    margin: auto;
    padding: 30px 24px;
    border-bottom: 1px solid #03235526;
  }
  .article-header .wordmark {
    font-size: 40px;
  }
  .article-back {
    font-size: 14px;
    text-underline-offset: 4px;
  }
  main {
    max-width: 808px;
    min-height: 75vh;
    margin: auto;
    padding: 88px 24px;
  }
  h1 {
    font-size: clamp(2.1rem, 5vw, 3.5rem);
    line-height: 1.08;
    letter-spacing: -0.045em;
    text-wrap: balance;
  }
  .article-body {
    margin-top: 48px;
    font-size: 18px;
    line-height: 1.75;
    overflow-wrap: anywhere;
  }
  .article-body :global(p),
  .article-body :global(ul),
  .article-body :global(ol),
  .article-body :global(blockquote) {
    margin-block: 1.25em;
  }
  .article-body :global(h2),
  .article-body :global(h3) {
    line-height: 1.2;
    margin-top: 2em;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }
  .article-body :global(h2) {
    font-size: clamp(26px, 3vw, 32px);
  }
  .article-body :global(h3) {
    font-size: 22px;
  }
  .article-body :global(a) {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .article-body :global(blockquote) {
    margin-inline: 0;
    padding-left: 20px;
    border-left: 2px solid #0074a3;
  }
  .article-body :global(li + li) {
    margin-top: 0.4em;
  }
  .article-body :global(ul),
  .article-body :global(ol) {
    padding-left: 1.5em;
  }
  .article-body :global(img) {
    max-width: 100%;
    height: auto;
  }
  .article-body :global(pre) {
    overflow-x: auto;
    padding: 16px;
  }
  @media (max-width: 600px) {
    .article-header {
      padding: 22px 20px;
      gap: 16px;
    }
    .article-back {
      font-size: 12px;
    }
    main {
      padding: 56px 22px;
    }
  }
</style>
