---
const disciplines = [
  { x: 99, y: 25, w: 118, lines: ['Desarrollo', 'de software'], d: 'M158 73 271 123' },
  { x: 294, y: 15, w: 100, lines: ['Ciencia', 'de datos'], d: 'M344 63 344 108' },
  { x: 473, y: 26, w: 114, lines: ['Política', 'pública'], d: 'M530 74 403 125' },
  { x: 86, y: 229, w: 115, lines: ['Educación'], d: 'M143 229 281 174' },
  { x: 455, y: 229, w: 137, lines: ['Salud pública'], d: 'M523 229 401 177' },
];
const mobileDisciplines = [
  { x: 3, y: 18, w: 108, lines: ['Desarrollo', 'de software'], d: 'M57 66 146 124' },
  { x: 134, y: 0, w: 92, lines: ['Ciencia', 'de datos'], d: 'M180 48 180 101' },
  { x: 249, y: 18, w: 108, lines: ['Política', 'pública'], d: 'M303 66 214 124' },
  { x: 3, y: 264, w: 105, lines: ['Educación'], d: 'M56 264 145 175' },
  { x: 237, y: 264, w: 120, lines: ['Salud pública'], d: 'M297 264 215 175' },
];
---

<svg
  class="team-visual team-desktop"
  viewBox="0 0 640 280"
  fill="none"
  role="img"
  aria-labelledby="team-visual-title team-visual-desc"
>
  <title id="team-visual-title">Un equipo multidisciplinario conectado</title>
  <desc id="team-visual-desc"
    >Dixios conecta desarrollo de software, ciencia de datos, política pública, educación y salud
    pública.</desc
  >
  <defs>
    <linearGradient id="team-face"
      ><stop stop-color="#008dff"></stop><stop offset="1" stop-color="#0752dc"
      ></stop></linearGradient
    >
    <linearGradient id="team-top"
      ><stop stop-color="#048eff"></stop><stop offset="1" stop-color="#073dc7"
      ></stop></linearGradient
    >
    <linearGradient id="team-core" x2="1" y2="1"
      ><stop stop-color="#007fe8" stop-opacity=".35"></stop><stop
        offset="1"
        stop-color="#003d9f"
        stop-opacity=".15"></stop></linearGradient
    >
  </defs>
  <g stroke="#2097ed" stroke-width=".5" opacity=".22"
    ><path d="M0 150H640M0 212H640M243 0V280M343 0V280M441 0V280M608 0V280"></path><circle
      cx="344"
      cy="151"
      r="82"
      stroke-dasharray="2 7"></circle></g
  >
  {
    disciplines.map((item, i) => (
      <g>
        <path d={item.d} stroke={i % 2 ? '#2fcbf3' : '#a4a8f7'} stroke-width=".8" opacity=".6" />
        <path
          class="signal"
          d={item.d}
          stroke={i % 2 ? '#54e9ff' : '#e6bcff'}
          stroke-width="2.5"
          stroke-linecap="round"
          pathLength="100"
          style={`--delay:${-i * 1.7}s`}
        />
        <rect
          x={item.x}
          y={item.y}
          width={item.w}
          height={item.lines.length === 1 ? 38 : 48}
          fill="#03469e"
          fill-opacity=".35"
          stroke="#2bb4f2"
          stroke-opacity=".6"
          stroke-width=".7"
        />
        <text
          x={item.x + item.w / 2}
          y={item.y + (item.lines.length === 1 ? 24 : 20)}
          fill="white"
          text-anchor="middle"
          font-size="14"
          letter-spacing="-.35"
        >
          {item.lines.map((line, j) => (
            <tspan x={item.x + item.w / 2} dy={j === 0 ? 0 : 15}>
              {line}
            </tspan>
          ))}
        </text>
      </g>
    ))
  }
  <g class="blocks" style="--delay:-2s">
    {
      [
        { x: 74, y: 107, s: 22, h: 37 },
        { x: 111, y: 126, s: 17, h: 43 },
        { x: 149, y: 115, s: 13, h: 79 },
        { x: 195, y: 155, s: 16, h: 29 },
        { x: 220, y: 121, s: 12, h: 22 },
      ].map((b) => (
        <g>
          <path
            d={`M${b.x} ${b.y}l${b.s} ${-b.s * 0.55} ${b.s} ${b.s * 0.55}-${b.s} ${b.s * 0.55}Z`}
            fill="url(#team-top)"
          />
          <path
            d={`M${b.x} ${b.y}l${b.s} ${b.s * 0.55}v${b.h}l-${b.s}-${b.s * 0.55}Z`}
            fill="url(#team-face)"
          />
          <path
            d={`M${b.x + b.s} ${b.y + b.s * 0.55}l${b.s}-${b.s * 0.55}v${b.h}l-${b.s} ${b.s * 0.55}Z`}
            fill="#0752c9"
          />
          <path
            d={`M${b.x + b.s} ${b.y + b.s * 0.55}v${b.h}`}
            stroke="#3cc7ff"
            stroke-opacity=".4"
          />
        </g>
      ))
    }
  </g>
  <g class="blocks" style="--delay:-5s"
    ><path d="m292 225 27-15 28 15-28 16Z" fill="#0395ff"></path><path
      d="m292 225 27 16v35l-27-15Z"
      fill="#006afa"></path><path d="m319 241 28-16v35l-28 16Z" fill="#0052d7"></path><path
      d="m252 237 14-8 15 8-15 8Z"
      fill="#9271ff"></path><path d="m252 237 14 8v18l-14-8Z" fill="#9746e5"></path><path
      d="m266 245 15-8v18l-15 8Z"
      fill="#6644ed"></path><path
      d="m292 225 27 16 28-16m-28 16v35"
      stroke="#60c7ff"
      stroke-width=".8"></path></g
  >
  <g class="data-field"
    >{
      Array.from({ length: 28 }, (_, i) => (
        <rect
          x={461 + (i % 4) * 13}
          y={113 + Math.floor(i / 4) * 12}
          width={i % 3 === 0 ? 8 : 5}
          height="8"
          fill={i % 5 === 0 ? '#00cbf5' : '#0083f9'}
          opacity={0.3 + (i % 4) * 0.16}
        />
      ))
    }
    {
      Array.from({ length: 12 }, (_, i) => (
        <path
          d={`M${526 + (i % 2) * 15} ${110 + Math.floor(i / 2) * 15}h6m-3-3v6`}
          stroke="#f480fa"
          stroke-width="1"
          opacity={0.4 + (i % 3) * 0.2}
        />
      ))
    }
  </g>
  <g fill="#03aefa" class="bars"
    >{
      [24, 43, 71, 49, 59, 91, 81, 106].map((h, i) => (
        <rect
          class="bar"
          x={553 + i * 10}
          y={225 - h}
          width="4"
          height={h}
          fill={i % 3 === 0 ? '#0772ff' : i % 3 === 1 ? '#00cafa' : '#ea5dee'}
          style={`--delay:${i * -0.9}s`}
        />
      ))
    }<path d="M547 227H636" stroke="#33a8f1" stroke-width=".6"></path></g
  >
  <g
    ><circle cx="344" cy="151" r="55" fill="url(#team-core)" stroke="#07c0f6" stroke-width="1"
    ></circle><circle cx="344" cy="96" r="3" fill="#a7d3ff"></circle><circle
      cx="294"
      cy="128"
      r="2.5"
      fill="#dcacff"></circle><circle cx="394" cy="129" r="2.5" fill="#ffd0f9"></circle><circle
      cx="299"
      cy="182"
      r="2"
      fill="#66c6ff"></circle><circle cx="389" cy="182" r="2" fill="#faadff"></circle><text
      x="344"
      y="161"
      text-anchor="middle"
      fill="white"
      font-size="33"
      font-weight="700"
      letter-spacing="-1.7">dixios</text
    ></g
  >
</svg>
<svg
  class="team-visual team-mobile"
  viewBox="0 0 360 306"
  fill="none"
  role="img"
  aria-labelledby="team-mobile-title team-mobile-desc"
>
  <title id="team-mobile-title">Un equipo multidisciplinario conectado</title>
  <desc id="team-mobile-desc"
    >Dixios conecta desarrollo de software, ciencia de datos, política pública, educación y salud
    pública.</desc
  >
  <g stroke="#2097ed" stroke-width=".6" opacity=".24"
    ><path d="M0 145H360M0 221H360M107 82V253M253 82V253"></path><circle
      cx="180"
      cy="145"
      r="67"
      stroke-dasharray="2 7"></circle></g
  >
  {
    mobileDisciplines.map((item, i) => (
      <g>
        <path d={item.d} stroke={i % 2 ? '#2fcbf3' : '#a4a8f7'} stroke-width=".85" opacity=".7" />
        <path
          class="signal"
          d={item.d}
          stroke={i % 2 ? '#54e9ff' : '#e6bcff'}
          stroke-width="2.5"
          stroke-linecap="round"
          pathLength="100"
          style={`--delay:${-i * 1.7}s`}
        />
        <rect
          x={item.x}
          y={item.y}
          width={item.w}
          height={item.lines.length === 1 ? 38 : 48}
          fill="#03469e"
          fill-opacity=".35"
          stroke="#2bb4f2"
          stroke-opacity=".7"
          stroke-width=".7"
        />
        <text
          x={item.x + item.w / 2}
          y={item.y + (item.lines.length === 1 ? 24 : 20)}
          fill="white"
          text-anchor="middle"
          font-size="14"
          letter-spacing="-.35"
        >
          {item.lines.map((line, j) => (
            <tspan x={item.x + item.w / 2} dy={j === 0 ? 0 : 15}>
              {line}
            </tspan>
          ))}
        </text>
      </g>
    ))
  }
  <g class="blocks" style="--delay:-2s">
    {
      [
        { x: 12, y: 130, s: 16, h: 29 },
        { x: 43, y: 145, s: 13, h: 35 },
        { x: 74, y: 130, s: 10, h: 62 },
      ].map((b) => (
        <g>
          <path
            d={`M${b.x} ${b.y}l${b.s} ${-b.s * 0.55} ${b.s} ${b.s * 0.55}-${b.s} ${b.s * 0.55}Z`}
            fill="#0079ee"
          />
          <path
            d={`M${b.x} ${b.y}l${b.s} ${b.s * 0.55}v${b.h}l-${b.s}-${b.s * 0.55}Z`}
            fill="#008afb"
          />
          <path
            d={`M${b.x + b.s} ${b.y + b.s * 0.55}l${b.s}-${b.s * 0.55}v${b.h}l-${b.s} ${b.s * 0.55}Z`}
            fill="#0752c9"
          />
          <path
            d={`M${b.x + b.s} ${b.y + b.s * 0.55}v${b.h}`}
            stroke="#3cc7ff"
            stroke-opacity=".5"
          />
        </g>
      ))
    }
  </g>
  <g class="data-field"
    >{
      Array.from({ length: 20 }, (_, i) => (
        <rect
          x={277 + (i % 4) * 12}
          y={102 + Math.floor(i / 4) * 10}
          width={i % 3 === 0 ? 6 : 4}
          height="6"
          fill={i % 5 === 0 ? '#00cbf5' : '#0083f9'}
          opacity={0.35 + (i % 4) * 0.16}
        />
      ))
    }
    {
      Array.from({ length: 6 }, (_, i) => (
        <path
          d={`M${330 + (i % 2) * 13} ${106 + Math.floor(i / 2) * 14}h5m-2.5-2.5v5`}
          stroke="#f480fa"
          stroke-width="1"
          opacity=".7"
        />
      ))
    }
  </g>
  <g class="bars"
    >{
      [24, 37, 54, 40, 64, 52, 75].map((h, i) => (
        <rect
          class="bar"
          x={278 + i * 11}
          y={231 - h}
          width="4"
          height={h}
          fill={i % 3 === 0 ? '#0772ff' : i % 3 === 1 ? '#00cafa' : '#ea5dee'}
          style={`--delay:${i * -0.9}s`}
        />
      ))
    }<path d="M271 233H356" stroke="#33a8f1" stroke-width=".6"></path></g
  >
  <g class="blocks" style="--delay:-5s"
    ><path d="m170 237 21-12 22 12-22 12Z" fill="#0395ff"></path><path
      d="m170 237 21 12v27l-21-12Z"
      fill="#006afa"></path><path d="m191 249 22-12v27l-22 12Z" fill="#0052d7"></path><path
      d="m136 243 11-6 11 6-11 6Z"
      fill="#9271ff"></path><path d="m136 243 11 6v14l-11-6Z" fill="#9746e5"></path><path
      d="m147 249 11-6v14l-11 6Z"
      fill="#6644ed"></path><path
      d="m170 237 21 12 22-12m-22 12v27"
      stroke="#60c7ff"
      stroke-width=".8"></path></g
  >
  <g
    ><circle
      cx="180"
      cy="145"
      r="44"
      fill="#005dbb"
      fill-opacity=".35"
      stroke="#07c0f6"
      stroke-width="1"></circle><circle cx="180" cy="101" r="2.5" fill="#a7d3ff"></circle><circle
      cx="143"
      cy="121"
      r="2.5"
      fill="#dcacff"></circle><circle cx="217" cy="121" r="2.5" fill="#ffd0f9"></circle><circle
      cx="148"
      cy="175"
      r="2"
      fill="#66c6ff"></circle><circle cx="212" cy="175" r="2" fill="#faadff"></circle><text
      x="180"
      y="154"
      text-anchor="middle"
      fill="white"
      font-size="29"
      font-weight="700"
      letter-spacing="-1.7">dixios</text
    ></g
  >
</svg>
<style>
  .team-visual {
    width: 100%;
    height: auto;
    display: block;
    overflow: visible;
    font-family: inherit;
  }
  .signal {
    stroke-dasharray: 2 98;
    animation: travel 11s linear infinite;
    animation-delay: var(--delay, 0s);
  }
  .blocks {
    animation: drift 11s ease-in-out infinite;
    animation-delay: var(--delay, 0s);
  }
  .bar {
    transform-box: fill-box;
    transform-origin: bottom;
    animation: breathe 9s ease-in-out infinite;
    animation-delay: var(--delay, 0s);
  }
  @keyframes travel {
    to {
      stroke-dashoffset: -100;
    }
  }
  @keyframes drift {
    50% {
      transform: translateY(-3px);
    }
  }
  @keyframes breathe {
    50% {
      transform: scaleY(0.94);
      opacity: 0.7;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .signal,
    .blocks,
    .bar {
      animation: none;
    }
  }
  :global([data-qa]) .signal,
  :global([data-qa]) .blocks,
  :global([data-qa]) .bar {
    animation: none;
  }
  .team-mobile {
    display: none;
  }
  @media (max-width: 600px) {
    .team-desktop {
      display: none;
    }
    .team-mobile {
      display: block;
    }
  }
</style>
