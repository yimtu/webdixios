---
import { hero } from '../../data/hero';
---
<div class="hero-content">
  <p class="hero-content__eyebrow">INTELIGENCIA · TRANSFORMACIÓN · TECNOLOGÍA INSTITUCIONAL</p>
  <h1>{hero.claim}</h1>
  <p class="hero-content__description">{hero.description}</p>
  <a class="hero-content__cta" href={hero.cta.href}>
    <span>{hero.cta.label}</span>
    <span aria-hidden="true">→</span>
  </a>
</div>
