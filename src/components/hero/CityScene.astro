---
const base = import.meta.env.BASE_URL;
const localModel = `${base}assets/hero/night-city.glb`;
const fallback = `${base}assets/hero/city-fallback.svg`;
const remoteModel = 'https://raw.githubusercontent.com/TonPlaygramBot/TonPlaygramWebApp/dccec03c704fce20e9414ad37d1efca0566a546b/webapp/public/assets/kart-royale/city.glb';
const sourceUrl = 'https://quaternius.com/packs/downtowncitymegakit.html';
---
<div
  class="hero-city"
  data-city-scene
  data-city-status="poster"
  data-city-src={localModel}
  data-city-remote-src={remoteModel}
>
  <img
    class="hero-city__poster"
    src={fallback}
    alt=""
    width="1600"
    height="1000"
    decoding="async"
    fetchpriority="high"
  />
  <canvas class="hero-city__canvas" aria-hidden="true"></canvas>
  <div class="hero-city__duotone" aria-hidden="true"></div>
  <div class="hero-city__vignette" aria-hidden="true"></div>
  <a class="hero-city__credit" href={sourceUrl} target="_blank" rel="noreferrer">
    Ciudad 3D: Quaternius · CC0
  </a>
</div>

<script>
  import { initHeroCityScenes } from '../../scripts/hero-city.js';
  initHeroCityScenes();
</script>
