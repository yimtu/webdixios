---
import { estadoDeCoordenada } from '@webrek/mx-geo';
import '../styles/global.css';
import '../styles/v04-fixes.css';
import '../styles/s00-attempt2.css';
import '../styles/s00-attempt3.css';
import '../styles/s00-attempt4.css';
import Home from '../components/Home.astro';

const base = import.meta.env.BASE_URL;
const favicon = `${base.endsWith('/') ? base : `${base}/`}favicon.svg`;

// Deterministic geographic sampling used only to increase local visual resolution
// inside the globe. The points are not observations, metrics, or city markers.
const heroFocusMarkers: [number, number][] = [];
let row = 0;
for (let lat = 14.4; lat <= 32.9; lat += 1.0) {
  const stagger = row % 2 === 0 ? 0 : 0.55;
  for (let lon = -117.2 + stagger; lon <= -86.5; lon += 1.1) {
    if (estadoDeCoordenada([lon, lat])) heroFocusMarkers.push([
      Number(lat.toFixed(2)),
      Number(lon.toFixed(2))
    ]);
  }
  row += 1;
}
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#063b8b" />
  <meta name="description" content="Dixios — inteligencia, transformación y tecnología institucional." />
  <link rel="icon" href={favicon} />
  <title>Dixios — Tecnología institucional para capacidad real</title>
</head>
<body>
  <Home />
  <script is:inline id="hero-focus-markers" type="application/json" set:html={JSON.stringify(heroFocusMarkers)}></script>
</body>
</html>
