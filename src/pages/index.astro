---
import '../styles/global.css';
import '../styles/refinements.css';
import Home from '../components/Home.astro';
const base = import.meta.env.BASE_URL;
const favicon = `${base.endsWith('/') ? base : `${base}/`}favicon.svg`;
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#001742" />
  <meta name="description" content="Dixios — inteligencia, transformación y tecnología institucional." />
  <link rel="icon" href={favicon} />
  <title>Dixios — Sistemas para instituciones que tienen que funcionar</title>
</head>
<body>
  <Home />
</body>
</html>
